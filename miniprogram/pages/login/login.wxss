.people{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px}
.who{height:48px;border-radius:12px;background:var(--card);border:1px solid var(--line);font-weight:800;display:flex;align-items:center;justify-content:center;color:var(--mute)}
.who.on{color:var(--text);border-color:var(--c);box-shadow:inset 0 -3px 0 var(--c)}
