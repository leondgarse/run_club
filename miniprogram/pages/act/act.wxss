.b{font-weight:700}
.xmore{margin-top:12px;border:1px solid var(--line);border-radius:12px;padding:0 12px}
.xsum{height:44px;display:flex;align-items:center;justify-content:space-between;font-size:14px}
.xn{font-size:12px;color:var(--mute)}
.shots{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.shot{position:relative;height:160px;border-radius:10px;overflow:hidden;background:var(--card);border:1px solid var(--line)}
.shot image{width:100%;height:100%}
.shot .ph{height:100%;display:flex;align-items:center;justify-content:center;color:var(--mute)}
.shotbusy{position:absolute;left:0;right:0;bottom:0;padding:4px;background:rgba(0,0,0,.6);color:#fff;font-size:11px;text-align:center}
.shotx{position:absolute;top:4px;right:4px;width:26px;height:26px;border-radius:13px;background:rgba(0,0,0,.6);color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center}
