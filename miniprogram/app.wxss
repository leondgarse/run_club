/* Same tokens as public/index.html. Dark by default; light follows the system (app.json darkmode). */
page{
  --bg:#0f1115; --card:#181b22; --card2:#1f232c; --line:#262a33; --text:#e8eaee; --mute:#9aa1ad;
  --ok:#3fb97a; --box:#4a505c; --strike:rgba(255,255,255,.35); --vio-bg:#2b2540; --vio-fg:#d9c8ff; --miss:#5a2a26;
  background:var(--bg); color:var(--text);
  font:15px/1.45 -apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;
}
@media (prefers-color-scheme: light){
  page{
    --bg:#f4f5f7; --card:#ffffff; --card2:#eceef2; --line:#dde1e7; --text:#15181e; --mute:#5d6572;
    --ok:#2f9e66; --box:#b5bcc7; --strike:rgba(0,0,0,.35); --vio-bg:#ece6fb; --vio-fg:#5a3fb0; --miss:#f0c2bb;
  }
}
view,text,button,input,textarea{box-sizing:border-box}
button{margin:0;padding:0;font:inherit;line-height:inherit;color:inherit;background:none;border-radius:0}
button::after{border:none}
.wrap{padding:0 16px 40px}
.mute{color:var(--mute)}

/* Forms (log / activity / goal / sign-in pages) */
.lkind{font-size:11px;text-transform:uppercase;letter-spacing:.7px;font-weight:700;margin-top:14px}
.ltitle{font-size:20px;font-weight:700;margin:2px 0 14px}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fgrid .span2{grid-column:1/-1}
.field{display:block;font-size:12px;font-weight:600;color:var(--mute)}
.field .u{font-weight:400;opacity:.7}
.field.full{margin-top:10px}
.inp{margin-top:4px;width:100%;height:46px;border-radius:11px;border:1px solid var(--line);background:var(--card);color:var(--text);padding:0 12px;font-size:16px}
.picker{display:flex;align-items:center}
.ta{margin-top:4px;width:100%;height:76px;border-radius:11px;border:1px solid var(--line);background:var(--card);color:var(--text);padding:10px 12px;font-size:16px}
.btn{width:100%;height:46px;border-radius:11px;background:var(--ok);color:#0f1115;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:16px}
.btn.ghost{background:var(--card2);color:var(--text);font-weight:600}
.btn.vio{background:var(--vio-bg);color:var(--vio-fg);font-weight:700}
.btn[disabled]{opacity:.6}
.actions{display:grid;grid-template-columns:1fr 2fr;gap:8px;margin-top:16px}
.actions.one{grid-template-columns:1fr}
.addphoto{display:flex;align-items:center;justify-content:center;height:52px;border:1px dashed var(--box);border-radius:12px;font-size:14px;margin-top:12px}
.thumb{margin-top:12px;border-radius:12px;overflow:hidden;background:var(--card);border:1px solid var(--line)}
.thumb image{display:block;width:100%}
.thumb .ph{height:80px;display:flex;align-items:center;justify-content:center;color:var(--mute);font-size:13px}
.hint{margin:6px 0 0;color:var(--mute);font-size:12px}
.justfilled{border-color:var(--ok)}
